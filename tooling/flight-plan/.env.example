# ---------------------------------------------------------------
# Flight Plan configuration. Copy to .env and fill in ONE provider.
# Keys stay on the server; the browser never sees them.
# ---------------------------------------------------------------

PORT=8080

# Which model provider compiles requirements:
#   anthropic | bedrock | vertex | azure-openai | openai-compatible | mock
# "mock" returns the built-in sample plan, so you can demo with no keys.
LLM_PROVIDER=mock

# Max tokens the compiler may write per plan, and request timeout.
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=180000

# --- Anthropic API (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- AWS Bedrock (Claude in your AWS account) ---
# Uses the standard AWS credential chain (env vars, profile, or instance role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# e.g. an inference profile ID such as us.anthropic.claude-...; copy it from the Bedrock console.

# --- Google Vertex AI (Claude in your GCP project) ---
# Uses Application Default Credentials (gcloud auth application-default login, or a service account).
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5
VERTEX_MODEL=
# e.g. the Claude model name shown in Vertex Model Garden.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
# e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Any OpenAI-compatible endpoint (OpenAI, LiteLLM gateway, vLLM, Ollama, etc.) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Access control (optional but recommended when deployed) ---
# Set both to require a username/password for the whole app.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Max compiles per user IP per hour.
COMPILE_RATE_LIMIT=20

# Where saved plans and customer profiles are written.
PLAN_STORE_DIR=./data/plans
CUSTOMER_STORE_DIR=./data/customers
# Max characters of customer documents sent to the model per compile.
PROMPT_DOC_BUDGET=60000
